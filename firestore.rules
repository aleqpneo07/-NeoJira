rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTask(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'subtitle', 'category', 'status',
          'dueDate', 'tag', 'progress', 'totalSubtasks', 'completedSubtasks',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'subtitle', 'category', 'status',
          'dueDate', 'tag', 'progress', 'totalSubtasks', 'completedSubtasks',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 80
        && data.category is string && data.category.size() >= 6 && data.category.size() <= 7
        && (data.category == 'trabajo' || data.category == 'examen' || data.category == 'diario')
        && data.status is string && data.status.size() == 9
        && (data.status == 'pendiente' || data.status == 'en_marcha' || data.status == 'terminado')
        && data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.tag is string && data.tag.size() >= 1 && data.tag.size() <= 40
        && data.progress is number && data.progress >= 0 && data.progress <= 100
        && data.totalSubtasks is number && data.totalSubtasks >= 0 && data.totalSubtasks <= 50
        && data.completedSubtasks is number && data.completedSubtasks >= 0 && data.completedSubtasks <= 50
        && data.completedSubtasks <= data.totalSubtasks
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSubtask(data) {
      return data.keys().hasAll([
          'ownerId', 'taskId', 'title', 'completed',
          'scheduleLabel', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'taskId', 'title', 'completed',
          'scheduleLabel', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && isValidId(data.taskId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.completed is bool
        && data.scheduleLabel is string && data.scheduleLabel.size() >= 0 && data.scheduleLabel.size() <= 30
        && data.sortOrder is number && data.sortOrder >= 0 && data.sortOrder <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isParentTaskOwner(taskId) {
      return exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.ownerId == request.auth.uid;
    }

    // Connection test endpoint read guard
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId);
      allow list, create, update, delete: if false;
    }

    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(taskId)
        && isValidTask(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update workflow status or progress metrics
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progress', 'totalSubtasks', 'completedSubtasks', 'tag', 'updatedAt']) ||
          // Action 2: Edit task details (title, subtitle, category, dueDate, tag, status, progress)
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'category', 'status', 'dueDate', 'tag', 'progress', 'totalSubtasks', 'completedSubtasks', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(taskId)
        && existing().ownerId == request.auth.uid;
    }

    match /subtasks/{subtaskId} {
      allow get: if isSignedIn()
        && isValidId(subtaskId)
        && existing().ownerId == request.auth.uid
        && isParentTaskOwner(existing().taskId);

      allow list: if isSignedIn()
        && existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(subtaskId)
        && isValidSubtask(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isParentTaskOwner(incoming().taskId);

      allow update: if isVerifiedUser()
        && isValidId(subtaskId)
        && isValidSubtask(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().taskId == existing().taskId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isParentTaskOwner(existing().taskId)
        && (
          // Action 1: Toggle completion or schedule label
          incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'scheduleLabel', 'updatedAt']) ||
          // Action 2: Edit subtask text, order, or label
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'completed', 'scheduleLabel', 'sortOrder', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(subtaskId)
        && existing().ownerId == request.auth.uid
        && isParentTaskOwner(existing().taskId);
    }
  }
}
